{
  "name": "manabi",
  "version": "0.2.0",
  "description": "Flashcards de japonés con repetición espaciada: kana, kanji, vocabulario, conjugación y gramática",
  "main": "dist-electron/main.js",
  "author": "omakehell",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "data:kanji": "node --experimental-strip-types scripts/build-kanji.ts",
    "data:words": "node --max-old-space-size=4096 --experimental-strip-types scripts/build-kanji-words.ts",
    "data:strokes": "node --max-old-space-size=4096 --experimental-strip-types scripts/build-kanjivg.ts",
    "make:icon": "electron scripts/make-icon.mjs && sips -Z 1024 build/icon.png --out build/icon.png",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "data:vocab": "node --max-old-space-size=4096 --experimental-strip-types scripts/build-kana-vocab.ts",
    "data:sentences": "node --max-old-space-size=8192 --experimental-strip-types scripts/build-sentences.ts",
    "data:vocabulary": "node --max-old-space-size=8192 --experimental-strip-types scripts/build-vocabulary.ts",
    "data:conjugation": "node --experimental-strip-types scripts/build-conjugation.ts",
    "data:components": "node --max-old-space-size=4096 --experimental-strip-types scripts/build-components.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^5.4.2",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/wanakana": "^4.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
